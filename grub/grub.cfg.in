set default=0
set timeout=30

# Detect architecture
if [ ${grub_cpu} = x86_64 ]; then
  set arch=x86_64
elif [ ${grub_cpu} = arm64 ] || [ ${grub_cpu} = aarch64 ]; then
  set arch=arm64
  set kernel_suffix=-aarch64
else
  set arch=x86_64
fi

if [ -z "${kernel_suffix}" ]; then
  set kernel_suffix=
fi

# Load architecture-appropriate modules
insmod linux
insmod loopback
insmod iso9660
insmod squash4
insmod ext2
insmod part_msdos
insmod part_gpt

# Probe the boot device
# First try to find the ISO by volume label.
# NOTE: Only ONE --set per search command. GRUB rejects duplicate --set args
# with "unexpected argument" errors.
search --no-floppy --set=isopart --label ENDERARCH_${FLAVOR}
if [ -n "${isopart}" ]; then
  set root="${isopart}"
else
  # Fall back: find the device containing the squashfs
  search --no-floppy --set=root --file /LiveOS/rootfs.sfs
fi

# Helper function for menu entries
function enderarch_entry {
  set kernel_name="$1"
  set kernel_ver="$2"
  set mode="$3"
  
  if [ "${mode}" = "ram" ]; then
    set mode_str="RAM"
  elif [ "${mode}" = "cow" ]; then
    set mode_str="USB COW"
  else
    set mode_str="${mode}"
  fi
  
  menuentry "Enderarch ${FLAVOR} (${kernel_name}) — ${mode_str}" --class arch {
    set gfxpayload=keep
    linux /boot/${arch}/vmlinuz-${kernel_ver}${kernel_suffix} archisobasedir=LiveOS archisodevice=/dev/disk/by-label/ENDERARCH_${FLAVOR} enderarch.mode=${mode} quiet splash
    initrd /boot/${arch}/initramfs-common.img /boot/${arch}/initramfs-enderarch.img
  }
}

function enderloader_entry {
  set kernel_name="$1"
  set kernel_ver="$2"
  
  menuentry "Enderloader ${FLAVOR} (${kernel_name})" --class arch --class recovery {
    set gfxpayload=keep
    linux /boot/${arch}/vmlinuz-${kernel_ver}${kernel_suffix} archisobasedir=LiveOS archisodevice=/dev/disk/by-label/ENDERARCH_${FLAVOR} enderarch.mode=recovery quiet
    initrd /boot/${arch}/initramfs-common.img /boot/${arch}/initramfs-enderloader.img
  }
}

# Main menu
menuentry "Boot Enderarch ${FLAVOR} (linux, RAM mode)" --class arch {
  linux /boot/${arch}/vmlinuz-linux${kernel_suffix} enderarch.mode=ram quiet splash
  initrd /boot/${arch}/initramfs-common.img /boot/${arch}/initramfs-enderarch.img
}

menuentry "Boot Enderarch ${FLAVOR} (linux-lts, RAM mode)" --class arch {
  linux /boot/${arch}/vmlinuz-linux-lts${kernel_suffix} enderarch.mode=ram quiet splash
  initrd /boot/${arch}/initramfs-common.img /boot/${arch}/initramfs-enderarch.img
}

menuentry "Boot Enderarch ${FLAVOR} (linux, USB COW mode)" --class arch {
  linux /boot/${arch}/vmlinuz-linux${kernel_suffix} enderarch.mode=cow quiet splash
  initrd /boot/${arch}/initramfs-common.img /boot/${arch}/initramfs-enderarch.img
}

menuentry "Boot Enderarch ${FLAVOR} (linux-lts, USB COW mode)" --class arch {
  linux /boot/${arch}/vmlinuz-linux-lts${kernel_suffix} enderarch.mode=cow quiet splash
  initrd /boot/${arch}/initramfs-common.img /boot/${arch}/initramfs-enderarch.img
}

menuentry "Enderloader Recovery (linux)" --class arch --class recovery {
  linux /boot/${arch}/vmlinuz-linux${kernel_suffix} enderarch.mode=recovery quiet
  initrd /boot/${arch}/initramfs-common.img /boot/${arch}/initramfs-enderloader.img
}

menuentry "Enderloader Recovery (linux-lts)" --class arch --class recovery {
  linux /boot/${arch}/vmlinuz-linux-lts${kernel_suffix} enderarch.mode=recovery quiet
  initrd /boot/${arch}/initramfs-common.img /boot/${arch}/initramfs-enderloader.img
}

menuentry "UEFI Firmware Settings" --class setup {
  fwsetup
}

menuentry "Reboot" --class reboot {
  reboot
}

menuentry "Shutdown" --class shutdown {
  halt
}

# On x86_64, show a BIOS boot note
if [ ${grub_cpu} = x86_64 ]; then
  echo "Enderarch ${FLAVOR} — Press ESC for menu"
fi
