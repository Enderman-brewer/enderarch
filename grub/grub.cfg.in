# Enderarch GRUB configuration
# Generated per-flavor by build.sh (${FLAVOR} is substituted).
#
# The ISO is an ISO 9660/UDF bridge: UDF is the canonical filesystem view,
# iso9660 remains only as the El Torito bootstrap carrier. 'udf' MUST be
# loaded before any media access.

set default=0
set timeout=15

# --- Terminal setup ---
# Prefer gfxterm when a font is available on the media; fall back to the
# firmware console otherwise.
if [ -f "${prefix}/fonts/unicode.pf2" ]; then
  insmod font
  if loadfont "${prefix}/fonts/unicode.pf2"; then
    set gfxmode=auto
    insmod all_video
    insmod gfxterm
    terminal_output gfxterm
  fi
fi

# --- Filesystem and disk modules ---
insmod part_msdos
insmod part_gpt
insmod udf
insmod iso9660
insmod linux

# --- Locate the boot media ---
# Fast path: our volume label. Fallback: the config file itself (works even
# if the label was mangled by a write tool).
if ! search --no-floppy --label ENDERARCH_${FLAVOR} --set=root; then
  search --no-floppy --file /boot/grub/grub.cfg --set=root
fi

# --- Architecture detection ---
if [ "${grub_cpu}" = "x86_64" ]; then
  set arch=x86_64
  set kernel_suffix=
elif [ "${grub_cpu}" = "arm64" ] || [ "${grub_cpu}" = "aarch64" ]; then
  set arch=arm64
  set kernel_suffix=-aarch64
else
  set arch=x86_64
  set kernel_suffix=
fi

# --- Entry generators ---
# NOTE: values are passed as menuentry arguments because the entry body is
# evaluated at BOOT time, not definition time — plain variables would all
# resolve to the last loop iteration's value.

function live_entry {
  # $1 = kernel base name, $2 = enderarch.mode, $3 = display label
  menuentry "Enderarch ${FLAVOR} (${1}) — ${3}" --class arch "$1" "$2" {
    set gfxpayload=keep
    linux /boot/${arch}/vmlinuz-${1}${kernel_suffix} archisobasedir=LiveOS archisodevice=/dev/disk/by-label/ENDERARCH_${FLAVOR} enderarch.mode=${2} quiet splash
    initrd /boot/${arch}/initramfs-common.img /boot/${arch}/initramfs-enderarch.img
  }
}

function loader_entry {
  # $1 = kernel base name
  menuentry "Enderloader Recovery (${1})" --class arch --class recovery "$1" {
    set gfxpayload=keep
    linux /boot/${arch}/vmlinuz-${1}${kernel_suffix} archisobasedir=LiveOS archisodevice=/dev/disk/by-label/ENDERARCH_${FLAVOR} enderarch.mode=recovery quiet
    initrd /boot/${arch}/initramfs-common.img /boot/${arch}/initramfs-enderloader.img
  }
}

# --- Main menu ---
for k in linux linux-lts; do
  live_entry "$k" ram "RAM mode"
  live_entry "$k" cow "USB COW mode"
done

submenu "Enderloader Recovery" --class recovery {
  loader_entry linux
  loader_entry linux-lts
}

if [ "${grub_platform}" = "efi" ]; then
  menuentry "UEFI Firmware Settings" --class setup {
    fwsetup
  }
fi

menuentry "Reboot" --class reboot {
  reboot
}

menuentry "Shutdown" --class shutdown {
  halt
}
