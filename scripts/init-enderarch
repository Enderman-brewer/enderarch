#!/bin/sh
# Enderarch Live Boot — /lib/enderarch/init-mode
# Called from common /init

echo "ENDERARCH: Starting live boot"

# Parse kernel cmdline
CMDLINE=$(cat /proc/cmdline)
MODE="ram"
echo "$CMDLINE" | grep -q "enderarch.mode=cow" && MODE="cow"
echo "ENDERARCH: Mode = $MODE"

# Find the squashfs — media detection lives in find-squashfs (UDF-first)
mkdir -p /mnt/iso
SFS_PATH="$(/lib/enderarch/find-squashfs /mnt/iso)"
if [ -z "$SFS_PATH" ] || [ ! -f "$SFS_PATH" ]; then
    echo "ENDERARCH: ERROR — Could not find rootfs.sfs!"
    echo "ENDERARCH: Tried all block devices. See diagnostics above."
    fail "rootfs.sfs not found — ISO missing LiveOS/rootfs.sfs or wrong device"
fi
echo "ENDERARCH: Found rootfs.sfs at ${SFS_PATH}"

# Mount squashfs
mkdir -p /mnt/squashfs
mount -t squashfs -o ro,loop "$SFS_PATH" /mnt/squashfs || fail "Could not mount rootfs.sfs ($SFS_PATH) — squashfs module missing?"

# Prepare overlay — COW storage on a dedicated tmpfs (ramfs lacks d_type,
# which overlayfs requires for the upper filesystem)
mkdir -p /mnt/enderarch/cow
mount -t tmpfs -o size=50% tmpfs /mnt/enderarch/cow || fail "Could not mount COW tmpfs at /mnt/enderarch/cow"
mkdir -p /mnt/enderarch/cow/work /mnt/enderarch/cow/upper
mkdir -p /newroot

if [ "$MODE" = "ram" ]; then
    echo "ENDERARCH: RAM mode — copying rootfs to tmpfs (USB can be removed after)..."
    mkdir -p /mnt/tmpfs
    mount -t tmpfs -o size=90% tmpfs /mnt/tmpfs || fail "Could not mount tmpfs for RAM mode"
    echo "    Copying files... this may take a minute."
    cp -a /mnt/squashfs/. /mnt/tmpfs/ || fail "RAM copy failed — not enough memory for the rootfs"
    # Create writable overlay on top of the tmpfs copy
    mount -t overlay overlay -o lowerdir=/mnt/tmpfs,upperdir=/mnt/enderarch/cow/upper,workdir=/mnt/enderarch/cow/work /newroot || fail "Overlay mount failed (RAM mode)"
else
    echo "ENDERARCH: USB COW mode — reading from USB, writes to tmpfs"
    mount -t overlay overlay -o lowerdir=/mnt/squashfs,upperdir=/mnt/enderarch/cow/upper,workdir=/mnt/enderarch/cow/work /newroot || fail "Overlay mount failed (COW mode)"
fi

echo "ENDERARCH: switch_root to live environment"

# Clean up udev before switch_root
udevadm control --exit 2>/dev/null || true

exec switch_root /newroot /sbin/init
