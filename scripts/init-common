#!/bin/sh
# Enderarch Common Initrd — /init

# Early setup
mount -t proc none /proc
mount -t sysfs none /sys
mount -t devtmpfs none /dev
mount -t tmpfs none /run

# Source verbose failure handler (sleeps infinity on fatal errors)
. /lib/enderarch/enderarch-fail

# Create essential directories
mkdir -p /lib/enderarch /mnt /newroot /proc /sys /dev /run /tmp

# Load core modules (built-in or from initrd)
modprobe loop 2>/dev/null || true
modprobe squashfs 2>/dev/null || true
modprobe overlay 2>/dev/null || true

# Architecture detection
ARCH=$(uname -m)
case "$ARCH" in
    x86_64)
        echo "ENDERARCH: Detected x86_64 architecture"
        ;;
    aarch64)
        echo "ENDERARCH: Detected ARM64 architecture — setting up x86_64 emulation"
        # Load binfmt_misc and register x86_64 emulator
        modprobe binfmt_misc 2>/dev/null || true
        if [ -f /usr/bin/qemu-x86_64-static ]; then
            # Register x86_64 binary format with binfmt_misc
            mount -t binfmt_misc binfmt_misc /proc/sys/fs/binfmt_misc 2>/dev/null || true
            echo ':x86_64:M::\x7fELF\x02\x01\x01\x00\x00\x00\x00\x00\x00\x00\x00\x00\x02\x00\x3e\x00:\xff\xff\xff\xff\xff\xfe\xfe\x00\xff\xff\xff\xff\xff\xff\xff\xff\xfe\xff\xff\xff:/usr/bin/qemu-x86_64-static:F' > /proc/sys/fs/binfmt_misc/register 2>/dev/null || echo "ENDERARCH: WARNING — could not register x86_64 binfmt"
        else
            echo "ENDERARCH: WARNING — qemu-x86_64-static not found, emulation unavailable"
        fi
        ;;
    *)
        echo "ENDERARCH: Unknown architecture: $ARCH"
        ;;
esac

# Load storage and filesystem modules
modprobe ahci 2>/dev/null || true
modprobe nvme 2>/dev/null || true
modprobe usb-storage 2>/dev/null || true
modprobe ext4 2>/dev/null || true
modprobe btrfs 2>/dev/null || true
modprobe vfat 2>/dev/null || true
modprobe ntfs3 2>/dev/null || true

# Start udev for device detection
udevd --daemon 2>/dev/null || true
udevadm trigger --action=add 2>/dev/null || true
udevadm settle 2>/dev/null || true

# Mount /mnt/enderarch from initrd contents
# (The initrd file tree should include this already)

# Dispatch to mode-specific init
if [ -f /lib/enderarch/init-mode ]; then
    echo "ENDERARCH: Loading mode: $(cat /proc/cmdline | grep -o 'enderarch\.mode=[^ ]*' || echo 'recovery')"
    . /lib/enderarch/init-mode
else
    echo "ENDERARCH: ERROR — no /lib/enderarch/init-mode found!"
    fail "No init-mode file at /lib/enderarch/init-mode — cannot boot"
fi
