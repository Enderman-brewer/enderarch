#!/bin/sh
# setup-binfmt — Register x86_64 emulation on ARM64
# Called by init-common when ARCH=aarch64

modprobe binfmt_misc 2>/dev/null || true
mount -t binfmt_misc binfmt_misc /proc/sys/fs/binfmt_misc 2>/dev/null || true

if [ -f /usr/bin/qemu-x86_64-static ]; then
    echo ':x86_64:M::\x7fELF\x02\x01\x01\x00\x00\x00\x00\x00\x00\x00\x00\x00\x02\x00\x3e\x00:\xff\xff\xff\xff\xff\xfe\xfe\x00\xff\xff\xff\xff\xff\xff\xff\xff\xfe\xff\xff\xff:/usr/bin/qemu-x86_64-static:F' > /proc/sys/fs/binfmt_misc/register 2>/dev/null && echo "setup-binfmt: x86_64 emulation registered" || echo "setup-binfmt: registration failed"
else
    echo "setup-binfmt: qemu-x86_64-static not found"
fi
