# install/enderloader-init — Enderloader recovery initrd

build() {
    # This image is unpacked AFTER the common image at boot, so its stock
    # 'base' /init would otherwise override the custom /init. Re-install the
    # custom /init (and the failure handler) here as well — the recovery
    # mode's rescan path re-execs init-mode in a fresh shell and needs fail().
    add_file /init /init 755
    add_file /lib/enderarch/enderarch-fail /lib/enderarch/enderarch-fail 755

    # Add the init-mode script
    add_file /lib/enderarch/init-mode /lib/enderarch/init-mode
    
    # Add helper scripts
    add_file /lib/enderarch/enderarch-scan /lib/enderarch/enderarch-scan
    
    # Add /mnt/enderloader directory tree with all assets
    add_dir /mnt/enderloader/docs
    add_dir /mnt/enderloader/bin
    add_dir /mnt/enderloader/etc
    
    # Add documentation
    add_file /mnt/enderloader/docs/common-issues.txt /mnt/enderloader/docs/common-issues.txt 2>/dev/null || true
    add_file /mnt/enderloader/docs/faq.txt /mnt/enderloader/docs/faq.txt 2>/dev/null || true
    
    # Add the profile.d dropin (guarded: the ARM build path may not stage it)
    add_file /etc/profile.d/88-enderloader.sh /etc/profile.d/88-enderloader.sh 2>/dev/null || true
}

help() {
    cat <<HELPEOF
This hook gathers the Enderloader recovery initrd:
- /lib/enderarch/init-mode — recovery TUI logic
- /mnt/enderloader/ — docs, scripts, assets
- /etc/profile.d/88-enderloader.sh — bind-mounted to real root
HELPEOF
}
