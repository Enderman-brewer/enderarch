# install/enderarch-init — Enderarch live boot initrd

build() {
    # This image is unpacked AFTER the common image at boot, so its stock
    # 'base' /init would otherwise override the custom /init. Re-install the
    # custom /init (and the failure handler) here as well.
    add_file /init /init 755
    add_file /lib/enderarch/enderarch-fail /lib/enderarch/enderarch-fail 755

    # Add the init-mode script
    add_file /lib/enderarch/init-mode /lib/enderarch/init-mode
    
    # Add helper scripts
    add_file /lib/enderarch/setup-overlay /lib/enderarch/setup-overlay
    add_file /lib/enderarch/find-squashfs /lib/enderarch/find-squashfs
    
    # Add /mnt/enderarch directory tree for COW storage
    add_dir /mnt/enderarch/cow/work
    add_dir /mnt/enderarch/cow/upper
}

help() {
    cat <<HELPEOF
This hook gathers the Enderarch live boot initrd:
- /lib/enderarch/init-mode — main live boot logic
- /mnt/enderarch/cow/ — overlay upper/work dirs
- Documentation
HELPEOF
}
